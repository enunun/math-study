# ---------------------------------------------------------------
# Dev container state (bind-mounted into the container at runtime)
# Created by "initializeCommand" in .devcontainer/devcontainer.json,
# so they are safe to ignore: they get recreated automatically.
# ---------------------------------------------------------------

# Claude Code home (/root/.claude): credentials, sessions, transcripts,
# caches, backups, plugins, memory
.devcontainer/claude-home/

# RTK home (/root/.config/rtk, /root/.local/share/rtk): user config,
# history DB, telemetry state, device salt
.devcontainer/rtk-home/

# ---------------------------------------------------------------
# Claude Code (project-level)
# Shared files such as CLAUDE.md, .claude/settings.json, .claude/agents/
# and .claude/skills/ stay tracked; only personal/local files are ignored.
# ---------------------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# ---------------------------------------------------------------
# RTK (project-level)
# .rtk/filters.toml is meant to be committed; ignore only local output.
# ---------------------------------------------------------------
.rtk/*
!.rtk/filters.toml

# ---------------------------------------------------------------
# Node / Astro
# ---------------------------------------------------------------
node_modules/
dist/
.astro/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Rust
# ---------------------------------------------------------------
target/

# ---------------------------------------------------------------
# mise (per-user config overrides)
# ---------------------------------------------------------------
mise.local.toml
.mise.local.toml

# ---------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
.credentials.json

# ---------------------------------------------------------------
# OS / editor / misc
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Logs and temporary files
*.log
*.tmp
*.bak
tmp/

# ---------------------------------------------------------------
# lefthook (local overrides)
# ---------------------------------------------------------------
lefthook-local.yml

# ---------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------
test-results/
playwright-report/
blob-report/

# ---------------------------------------------------------------
# MathJax fonts (copied from node_modules at build time)
# ---------------------------------------------------------------
site/public/mathjax-fonts/

# ---------------------------------------------------------------
# Rust: ビルドの出力と，Wasmから生成したファイル
# ---------------------------------------------------------------
target/
site/src/wasm/

# ---------------------------------------------------------------
# pnpm store (its location depends on the container; keep it out of git)
# ---------------------------------------------------------------
.pnpm-store/
