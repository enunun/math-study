{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  // 実験的なnursery以外の，すべてのカテゴリをerrorにする．
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
  },
  "options": {
    // 型情報を使うルールを有効にする．TypeScriptの診断はastro checkが担う．
    "typeAware": true,
    "reportUnusedDisableDirectives": "error",
  },
  "rules": {
    // 互いに矛盾する．Astroや各種の設定ファイルはdefault exportを要求する．
    "import/no-default-export": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",

    // nullを使わない方針(unicorn/no-null)と矛盾する．
    "no-undefined": "off",

    // 整形はoxfmtが担う．
    "sort-imports": "off",

    // Promiseを待たない呼び出し(イベントハンドラの中の非同期処理)は，文としてのvoidで，明示する．
    "no-void": ["error", { "allowAsStatement": true }],

    // 文字列のスプレッドは，コードポイントごとに分ける．位置を文字(コードポイント)で数える処理で使う．
    // prefer-spreadと矛盾する．
    "typescript/no-misused-spread": "off",

    // CSSの読み込みは，副作用のためのimportである．
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],

    // 設定オブジェクトのキーは，アルファベット順より意味のまとまりで並べる．
    "sort-keys": "off",

    // 宣言は，1つの文に1つの変数とする．
    "one-var": "off",

    // ?.，async/await，オブジェクトのスプレッドは標準の構文．Wasmの初期化やfetchにも使う．
    "oxc/no-optional-chaining": "off",
    "oxc/no-async-await": "off",
    "oxc/no-rest-spread-properties": "off",

    // 三項演算子と，行内コメントは使う．
    "no-ternary": "off",
    "no-inline-comments": "off",

    // コメントは日本語で書くため，大文字始まりの規則は適用できない．
    "capitalized-comments": "off",

    // 数式のコードでは，x，n，iなどの1文字の変数名が自然．
    "id-length": "off",

    // 数値リテラルは，0，1，-1だけ許す．
    "no-magic-numbers": ["error", { "ignore": [-1, 0, 1] }],

    // 型のインポートは，値のインポートと別の行に書く．
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],

    // 関数は宣言で書く．アロー関数はコールバックに使える．
    "func-style": ["error", "declaration", { "allowArrowFunctions": true }],

    // DOMの型(Elementなど)はreadonlyにできない．
    "typescript/prefer-readonly-parameter-types": "off",

    // awaitのないasync関数を禁じるrequire-awaitと矛盾する．Promiseを返すだけの関数は，asyncにしない．
    "typescript/promise-function-async": "off",
  },
  "overrides": [
    {
      // Astroのコンポーネントは，PascalCaseのファイル名にする．
      // 先頭のコードブロックは常にモジュールとして扱われる．
      "files": ["**/*.astro"],
      "rules": {
        "unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }],
        "import/unambiguous": "off",
      },
    },
    {
      // E2Eテストと，その設定，配信用のスクリプトは，Node.jsで実行する．
      // describeには多数のテストをまとめ，期待値には件数などの数値を書く．
      // ブラウザの中で測る関数は，外の変数を使えないため，1つの関数にまとめる．文の数の上限は外す．
      // innerTextはPlaywrightのメソッドで，DOMのプロパティではない．
      // スクリプトは，ESMのまま直接実行するため，トップレベルのawaitを使える．
      "files": ["e2e/**", "playwright.config.ts"],
      "rules": {
        "import/no-nodejs-modules": "off",
        "node/no-sync": "off",
        "node/no-top-level-await": "off",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "no-magic-numbers": "off",
        "unicorn/prefer-dom-node-text-content": "off",
      },
    },
    {
      // remark-lintの設定は，使うプラグインを並べるため，依存が多くなる．
      "files": [".remarkrc.mjs"],
      "rules": {
        "import/max-dependencies": "off",
      },
    },
    {
      // 型の宣言ファイルは，importやexportを持たない，スクリプトとして書く．
      "files": ["**/*.d.ts"],
      "rules": {
        "import/unambiguous": "off",
      },
    },
    {
      // 単体テストは，describeに多数のテストをまとめる．期待値には数値を書き，Wasmは，同期で読み込む．
      "files": ["**/*.test.ts"],
      "rules": {
        "max-lines-per-function": "off",
        "max-statements": "off",
        "no-magic-numbers": "off",
        "import/no-nodejs-modules": "off",
        "node/no-sync": "off",
      },
    },
    {
      // ブラウザで動くMathJaxは，グローバルなオブジェクトから，型を主張して読む．
      "files": ["site/src/calculator/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
      },
    },
    {
      // ビルド時にNode.jsで動く処理(Astroの設定，MathJaxのWorker，Astroの統合，rehypeプラグイン)．
      // Node.jsの組み込みモジュールを使う．親ディレクトリのモジュールは，設定ファイルからも読み込まれるため，
      // tsconfigの別名ではなく相対パスで読み込む．
      // Workerとのメッセージのやり取りは，new Promiseで待ち受ける．Workerは，トップレベルのawaitでMathJaxを起動する．
      // postMessageのtargetOriginは，windowのメッセージ用の引数で，Workerには当てはまらない．
      // グローバルなMathJaxオブジェクトと，workerDataは，型を主張して読む．
      // メッセージのハンドラと，開発サーバーのミドルウェアには，async関数を渡す．
      // ミドルウェアは，中で例外を処理する．
      "files": [
        "site/astro.config.ts",
        "site/src/math/**",
        "site/src/integrations/**",
        "site/src/plugins/**",
      ],
      "rules": {
        "import/no-nodejs-modules": "off",
        "import/no-relative-parent-imports": "off",
        "promise/avoid-new": "off",
        "node/no-top-level-await": "off",
        "unicorn/require-post-message-target-origin": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-misused-promises": "off",
        "typescript/strict-void-return": "off",
        "oxc/no-async-endpoint-handlers": "off",
      },
    },
  ],
  // site/src/wasm/は，wasm-bindgenが生成したコードである．
  "ignorePatterns": ["**/dist/**", "**/.astro/**", "**/target/**", "site/src/wasm/**"],
}
