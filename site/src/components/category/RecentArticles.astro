---
// すべてのカテゴリから，公開日(frontmatterのdate)の新しい記事を並べる．
import { getCollection } from 'astro:content';

import { formatDate, pageHref, placeOf, recentArticles } from './categories';

interface Props {
  count: number;
}

const articles = recentArticles(await getCollection('docs'), Astro.props.count);
const base = import.meta.env.BASE_URL;
---

<ul class="recent-articles">
  {
    articles.map((article) => (
      <li>
        <a href={pageHref(base, article.id)}>{article.title}</a>
        <span class="meta">
          <time datetime={article.date.toISOString().slice(0, 10)}>{formatDate(article.date)}</time>
          <span>{placeOf(article.id)}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .recent-articles {
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-direction: column;
  }
  li + li {
    margin-top: 0.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
