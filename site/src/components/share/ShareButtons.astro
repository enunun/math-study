---
import { Icon } from '@astrojs/starlight/components';

import { shareLinks, shareTitle } from './share-links';

// 共有するURLは，公開先のサイトのURLにする．
const url = new URL(Astro.url.pathname, Astro.site).href;
const { entry, siteTitle } = Astro.locals.starlightRoute;
const title = shareTitle(entry.data.title, siteTitle);
const links = shareLinks(title, url);
---

<nav class="share not-content" aria-label="このページを共有">
  <span class="share-label">共有：</span>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.icon && <Icon name={link.icon} />}
            <span>{link.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
  }
  .share-label {
    color: var(--sl-color-gray-3);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
</style>
