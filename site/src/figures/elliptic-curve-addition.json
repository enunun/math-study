{
  "version": "0.1.0",
  "description": "楕円曲線y^2 = x^3 - 2x + 2の上の点PとQの和．PとQを通る直線が曲線と交わる3つ目の点を，x軸について折り返すとP+Qになる．",
  "view": { "x": [-2.5, 3], "y": [-3, 3], "unit": { "x": "1cm", "y": "1cm" } },
  "objects": [
    { "id": "x_axis", "type": "axis", "direction": "x", "label": "x" },
    { "id": "y_axis", "type": "axis", "direction": "y", "label": "y" },
    { "id": "origin_label", "type": "label", "at": [0, 0], "anchor": "north east", "tex": "$O$" },
    { "id": "px", "type": "parameter", "value": -1.6, "range": [-1.7, 2.2], "step": 0.01 },
    { "id": "qx", "type": "parameter", "value": 1.8, "range": [-1.7, 2.2], "step": 0.01 },
    { "id": "curve", "type": "elliptic_curve", "a": -2, "b": 2, "p": "px", "q": "qx" }
  ]
}
