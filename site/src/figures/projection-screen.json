{
  "version": "0.1.0",
  "description": "画面は，原点を通り，rとuが張る平面である．点Pの像P'は，Pから画面へ下ろした垂線の足であり，奥行きは，その垂線の長さである．方位角60度，仰角20度で見る向きを，別の向きから示す．",
  "view": {
    "azimuth": 135,
    "elevation": 24,
    "unit": "1.2cm"
  },
  "objects": [
    {
      "id": "az",
      "type": "parameter",
      "value": 1.0471975512
    },
    {
      "id": "el",
      "type": "parameter",
      "value": 0.3490658504
    },
    {
      "id": "D",
      "type": "point",
      "at": ["cos(el)*cos(az)", "cos(el)*sin(az)", "sin(el)"]
    },
    {
      "id": "R",
      "type": "point",
      "at": ["-sin(az)", "cos(az)", 0]
    },
    {
      "id": "U",
      "type": "point",
      "at": ["-sin(el)*cos(az)", "-sin(el)*sin(az)", "cos(el)"]
    },
    {
      "id": "P",
      "type": "point",
      "at": [3, 1, 2],
      "dot": true,
      "label": "P",
      "anchor": "south west"
    },
    {
      "id": "S",
      "type": "point",
      "at": ["P_x*D_x+P_y*D_y+P_z*D_z", "P_x*R_x+P_y*R_y+P_z*R_z", "P_x*U_x+P_y*U_y+P_z*U_z"]
    },
    {
      "id": "Q",
      "type": "point",
      "at": ["P_x-S_x*D_x", "P_y-S_x*D_y", "P_z-S_x*D_z"],
      "dot": true,
      "label": "P'",
      "anchor": "north east"
    },
    {
      "id": "Xr",
      "type": "point",
      "at": ["S_y*R_x", "S_y*R_y", "S_y*R_z"]
    },
    {
      "id": "screen",
      "type": "surface",
      "boundary": true,
      "style": {
        "color": "gray"
      },
      "bezier": [
        [
          ["-3.2*R_x-2.6*U_x", "-3.2*R_y-2.6*U_y", "-3.2*R_z-2.6*U_z"],
          ["-3.2*R_x+2.6*U_x", "-3.2*R_y+2.6*U_y", "-3.2*R_z+2.6*U_z"]
        ],
        [
          ["3.2*R_x-2.6*U_x", "3.2*R_y-2.6*U_y", "3.2*R_z-2.6*U_z"],
          ["3.2*R_x+2.6*U_x", "3.2*R_y+2.6*U_y", "3.2*R_z+2.6*U_z"]
        ]
      ]
    },
    {
      "id": "x_axis",
      "type": "axis",
      "direction": "x",
      "range": [-0.5, 3.6],
      "label": "x",
      "style": {
        "color": "gray"
      }
    },
    {
      "id": "y_axis",
      "type": "axis",
      "direction": "y",
      "range": [-0.5, 2.2],
      "label": "y",
      "style": {
        "color": "gray"
      }
    },
    {
      "id": "z_axis",
      "type": "axis",
      "direction": "z",
      "range": [-0.5, 3.2],
      "label": "z",
      "style": {
        "color": "gray"
      }
    },
    {
      "id": "O",
      "type": "point",
      "at": [0, 0, 0],
      "label": "O",
      "anchor": "north east"
    },
    {
      "id": "ray",
      "type": "segment",
      "from": "P",
      "to": "Q",
      "style": {
        "line": "dashed"
      }
    },
    {
      "id": "step_r",
      "type": "segment",
      "from": "O",
      "to": "Xr",
      "style": {
        "color": "orange",
        "line": "dashed",
        "width": "1.2pt"
      }
    },
    {
      "id": "step_u",
      "type": "segment",
      "from": "Xr",
      "to": "Q",
      "style": {
        "color": "purple",
        "line": "dashed",
        "width": "1.2pt"
      }
    },
    {
      "id": "d_tip",
      "type": "point",
      "at": ["3.4*D_x", "3.4*D_y", "3.4*D_z"]
    },
    {
      "id": "r_tip",
      "type": "point",
      "at": ["1.6*R_x", "1.6*R_y", "1.6*R_z"]
    },
    {
      "id": "u_tip",
      "type": "point",
      "at": ["1.6*U_x", "1.6*U_y", "1.6*U_z"]
    },
    {
      "id": "d",
      "type": "vector",
      "from": "O",
      "to": "d_tip",
      "style": {
        "width": "1.2pt"
      }
    },
    {
      "id": "r",
      "type": "vector",
      "from": "O",
      "to": "r_tip",
      "style": {
        "color": "orange",
        "width": "1.2pt"
      }
    },
    {
      "id": "u",
      "type": "vector",
      "from": "O",
      "to": "u_tip",
      "style": {
        "color": "purple",
        "width": "1.2pt"
      }
    },
    {
      "id": "d_name",
      "type": "label",
      "at": "d_tip",
      "anchor": "east",
      "tex": "$\\boldsymbol{d}$"
    },
    {
      "id": "r_name",
      "type": "label",
      "at": "r_tip",
      "anchor": "north",
      "tex": "$\\boldsymbol{r}$"
    },
    {
      "id": "u_name",
      "type": "label",
      "at": "u_tip",
      "anchor": "east",
      "tex": "$\\boldsymbol{u}$"
    }
  ]
}
