{
  "version": "0.1.0",
  "description": "関数f(x, y) = sin x cos yの値を，正を赤，負を青で塗り，等高線を重ねた図．",
  "view": { "x": [-3.5, 3.5], "y": [-3.5, 3.5], "unit": { "x": "0.8cm", "y": "0.8cm" } },
  "objects": [
    { "id": "values", "type": "heatmap", "expr": "sin(x) * cos(y)", "colormap": "coolwarm" },
    {
      "id": "contours",
      "type": "implicit_curve",
      "vars": ["u", "v"],
      "expr": ["u", "v"],
      "domain": [
        [-3.5, 3.5],
        [-3.5, 3.5]
      ],
      "level": "sin(u) * cos(v)",
      "values": [-0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75],
      "style": { "width": "0.4pt" }
    },
    { "id": "x_axis", "type": "axis", "direction": "x", "label": "x" },
    { "id": "y_axis", "type": "axis", "direction": "y", "label": "y" }
  ]
}
