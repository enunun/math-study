{
  "version": "0.1.0",
  "description": "z=(x^2+y^2)/4の曲面と，点Pにおける接平面．",
  "view": { "azimuth": 50, "elevation": 25, "unit": "1cm" },
  "objects": [
    { "id": "x_axis", "type": "axis", "direction": "x", "range": [-3, 3], "label": "x" },
    { "id": "y_axis", "type": "axis", "direction": "y", "range": [-3, 3], "label": "y" },
    { "id": "z_axis", "type": "axis", "direction": "z", "range": [-1, 4], "label": "z" },
    {
      "id": "origin_label",
      "type": "label",
      "at": [0, 0, 0],
      "anchor": "north east",
      "tex": "$O$"
    },
    {
      "id": "s",
      "type": "surface",
      "vars": ["u", "v"],
      "expr": ["u", "v", "(u^2 + v^2) / 4"],
      "domain": [
        [-2, 2],
        [-2, 2]
      ],
      "style": { "color": "blue" }
    },
    { "id": "p", "type": "point", "at": [1, 1, 0.5], "dot": true, "label": "P", "anchor": "north" },
    {
      "id": "tangent",
      "type": "tangent_plane",
      "of": "s",
      "at": [1, 1],
      "size": 1.2,
      "style": { "color": "red" }
    }
  ]
}
