{
  "version": "0.1.0",
  "description": "矩形波のフーリエ級数の振幅のスペクトル．奇数次だけが，次数に反比例する大きさ4/(nπ)をもつ．",
  "view": { "x": [-0.5, 12], "y": [-0.2, 1.5], "unit": { "x": "0.6cm", "y": "3cm" } },
  "objects": [
    { "id": "x_axis", "type": "axis", "direction": "x", "label": "n" },
    { "id": "y_axis", "type": "axis", "direction": "y", "label": "A_n" },
    {
      "id": "spectrum",
      "type": "fourier_series",
      "expr": "x / abs(x)",
      "period": ["-pi", "pi"],
      "terms": 11,
      "mode": "amplitude",
      "style": { "color": "blue" }
    }
  ]
}
