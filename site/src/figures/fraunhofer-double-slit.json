{
  "version": "0.1.0",
  "description": "間隔2dの2つのスリット(幅2w)のFraunhofer回折の強さ．単スリットの回折の包絡線の中に，2つのスリットの干渉の縞が並ぶ．",
  "view": { "x": [-24, 24], "y": [-8, 8], "unit": { "x": "0.2cm", "y": "0.2cm" } },
  "objects": [
    { "id": "d", "type": "parameter", "value": 1, "range": [0.4, 2], "step": 0.05 },
    { "id": "w", "type": "parameter", "value": 0.15, "range": [0.05, 0.35], "step": 0.01 },
    {
      "id": "pattern",
      "type": "fourier_intensity",
      "expr": "(1 - (abs(abs(x) - d) - w) / abs(abs(abs(x) - d) - w)) / 2",
      "support": [
        [-2.5, 2.5],
        [-0.8, 0.8]
      ],
      "samples": 256,
      "tikz_resolution": 120
    },
    {
      "id": "x_axis",
      "type": "axis",
      "direction": "x",
      "label": "k_x",
      "style": { "color": "gray" }
    }
  ]
}
