{
  "version": "0.1.0",
  "description": "カメラの向きd．dの水平な成分がx軸となす角が方位角a，水平面からの角が仰角eである．",
  "view": {
    "azimuth": 32,
    "elevation": 36,
    "unit": "3.6cm"
  },
  "objects": [
    {
      "id": "az",
      "type": "parameter",
      "value": 1.0471975512
    },
    {
      "id": "el",
      "type": "parameter",
      "value": 0.3490658504
    },
    {
      "id": "x_axis",
      "type": "axis",
      "direction": "x",
      "range": [-0.15, 1.35],
      "label": "x"
    },
    {
      "id": "y_axis",
      "type": "axis",
      "direction": "y",
      "range": [-0.15, 1.35],
      "label": "y"
    },
    {
      "id": "z_axis",
      "type": "axis",
      "direction": "z",
      "range": [-0.15, 1.2],
      "label": "z"
    },
    {
      "id": "O",
      "type": "point",
      "at": [0, 0, 0],
      "label": "O",
      "anchor": "north east"
    },
    {
      "id": "D",
      "type": "point",
      "at": ["cos(el)*cos(az)", "cos(el)*sin(az)", "sin(el)"]
    },
    {
      "id": "F",
      "type": "point",
      "at": ["D_x", "D_y", 0]
    },
    {
      "id": "foot",
      "type": "segment",
      "from": "O",
      "to": "F",
      "style": {
        "line": "dashed",
        "color": "gray"
      }
    },
    {
      "id": "drop",
      "type": "segment",
      "from": "F",
      "to": "D",
      "style": {
        "line": "dashed",
        "color": "gray"
      }
    },
    {
      "id": "d",
      "type": "vector",
      "from": "O",
      "to": "D",
      "style": {
        "width": "1.2pt"
      }
    },
    {
      "id": "d_name",
      "type": "label",
      "at": "D",
      "anchor": "south west",
      "tex": "$\\boldsymbol{d}$"
    },
    {
      "id": "arc_a",
      "type": "curve",
      "var": "t",
      "expr": ["0.5*cos(t)", "0.5*sin(t)", "0"],
      "domain": [0, "az"],
      "style": {
        "color": "blue"
      }
    },
    {
      "id": "name_a",
      "type": "label",
      "at": ["0.7*cos(az/2)", "0.7*sin(az/2)", 0],
      "anchor": "center",
      "tex": "$a$"
    },
    {
      "id": "arc_e",
      "type": "curve",
      "var": "t",
      "expr": ["0.75*cos(t)*cos(az)", "0.75*cos(t)*sin(az)", "0.75*sin(t)"],
      "domain": [0, "el"],
      "style": {
        "color": "red"
      }
    },
    {
      "id": "name_e",
      "type": "label",
      "at": ["0.9*cos(el/2)*cos(az)", "0.9*cos(el/2)*sin(az)", "0.9*sin(el/2)"],
      "anchor": "west",
      "tex": "$e$"
    }
  ]
}
