{
  "version": "0.1.0",
  "description": "楕円曲線y^2 = x^3 - xの上の点Pの2倍．実の点は，閉じた卵形と，右へ伸びる枝に分かれる．Pでの接線が曲線と交わるもう1つの点を，x軸について折り返すと2Pになる．",
  "view": { "x": [-2, 3.5], "y": [-3.5, 3.5], "unit": { "x": "1cm", "y": "1cm" } },
  "objects": [
    { "id": "x_axis", "type": "axis", "direction": "x", "label": "x" },
    { "id": "y_axis", "type": "axis", "direction": "y", "label": "y" },
    { "id": "origin_label", "type": "label", "at": [0, 0], "anchor": "north east", "tex": "$O$" },
    { "id": "px", "type": "parameter", "value": 1.3, "range": [1.02, 2.5], "step": 0.01 },
    { "id": "curve", "type": "elliptic_curve", "a": -1, "b": 0, "p": "px" }
  ]
}
