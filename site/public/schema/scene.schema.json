{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enunun.github.io/math-study/schema/scene.schema.json",
  "title": "図のシーン",
  "description": "数学の学習サイトの図が読み書きする，シーンのJSONの形式．図の作成ページ(/math-study/figure-editor/)の「JSON」タブで編集するものと同じである．",
  "type": "object",
  "required": ["version", "description", "view", "objects"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "このシーンを書いたエンジンの版(semver)．読み込むエンジンの版と，主版が同じで(主版が0の間は副版も同じ)，エンジンより新しくない版だけを読める．"
    },
    "description": {
      "$ref": "#/$defs/nonBlankString",
      "description": "図の説明．SVGの代替テキスト(alt)になるので，空白だけの文字列は書けない．"
    },
    "view": { "$ref": "#/$defs/view" },
    "objects": {
      "type": "array",
      "description": "図を作るオブジェクトの並び．並びは，描く順であり，参照の順でもある(点は，その点を使うベクトルより前に置く必要はないが，`<id>_x`などの名前は，あとに置いたオブジェクトからしか使えない)．",
      "items": { "$ref": "#/$defs/object" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "英字で始まり，英数字と`_`だけでできた名前．オブジェクトの`id`と，`var`(媒介変数の名前)，曲面の`vars`に使う．シーンの中で重ならないこと，`e`・`pi`・関数の名前(`sin`など)と重ならないことが必要である．"
    },
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S",
      "description": "空文字列や，空白だけの文字列を除いた，文字列．"
    },
    "bound": {
      "description": "数か，式(文字列)．式の構文が正しいか，式が指す名前(媒介変数，先に置いたパラメータや点の座標)が存在するかは，スキーマでは表せず，エンジンが式を読むときに確かめる．",
      "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/nonBlankString" }]
    },
    "positiveNumberOrExpression": {
      "description": "格子の刻み(`x_step`，`y_step`)，接平面の半径(`size`)，曲面のワイヤーフレームの刻み(`wireframe_step`)に使う．数で書くときは，正の数でなければならない．式で書くときの正負は，エンジンが式を評価するときに確かめる．",
      "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "$ref": "#/$defs/nonBlankString" }]
    },
    "numberPair": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "boundPair": {
      "type": "array",
      "items": { "$ref": "#/$defs/bound" },
      "minItems": 2,
      "maxItems": 2
    },
    "length": {
      "type": "string",
      "pattern": "^(\\d+\\.\\d+|\\d+|\\.\\d+)(cm|mm|pt)$",
      "description": "単位つきの長さ(`\"1.2pt\"`のような文字列)．数値は正でなければならない．線の太さ(`style.width`)は，さらに0より大きく10pt以下でなければならない．"
    },
    "anchor": {
      "type": "string",
      "enum": [
        "center",
        "north",
        "south",
        "east",
        "west",
        "north east",
        "north west",
        "south east",
        "south west"
      ],
      "description": "ラベルの箱の，位置に合わせる部分．TikZのanchorと同じ名前である．"
    },
    "color": {
      "type": "string",
      "enum": ["gray", "red", "blue", "green", "orange", "purple"],
      "description": "決まった名前から選ぶ，線の色．省くと，文字の色になる．"
    },
    "line": { "type": "string", "enum": ["solid", "dotted", "dashed"] },
    "hidden": {
      "type": "string",
      "enum": ["dotted", "dashed", "none"],
      "description": "空間の図で，不透明な面に隠れた部分の線の描き方．"
    },
    "arrow": { "type": "string", "enum": ["stealth", "none"] },
    "direction": {
      "type": "string",
      "enum": ["x", "y", "z"],
      "description": "`z`は，空間の図でだけ使える．"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "線のスタイル．省いた項目は，オブジェクトの種類ごとの既定になる(既定の線の種類は，格子だけ点線，ほかは実線)．",
      "properties": {
        "line": { "$ref": "#/$defs/line" },
        "hidden": { "$ref": "#/$defs/hidden" },
        "color": { "$ref": "#/$defs/color" },
        "width": { "$ref": "#/$defs/length" }
      }
    },
    "tick": {
      "type": "object",
      "required": ["at"],
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/bound",
          "description": "軸の上の位置．軸の範囲の中でなければならない．"
        },
        "label": { "type": "string" },
        "anchor": { "$ref": "#/$defs/anchor" }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "opacity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "既定は0.25．"
        }
      }
    },
    "position": {
      "description": "オブジェクトの位置．座標の並び(平面の図では2個，空間の図では3個)か，点の式(平面の図だけで使える文字列，`\"B + C - A\"`のような形)で書く．どちらの形にするかは，`view`によって決まる．",
      "oneOf": [
        { "$ref": "#/$defs/nonBlankString" },
        { "type": "array", "items": { "$ref": "#/$defs/bound" }, "minItems": 2, "maxItems": 3 }
      ]
    },
    "planeView": {
      "type": "object",
      "required": ["x", "y", "unit"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/numberPair", "description": "x方向の，見える範囲．小さい方が先．" },
        "y": { "$ref": "#/$defs/numberPair", "description": "y方向の，見える範囲．小さい方が先．" },
        "unit": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": { "x": { "$ref": "#/$defs/length" }, "y": { "$ref": "#/$defs/length" } },
          "description": "x方向とy方向それぞれの，1単位の実寸．"
        }
      }
    },
    "spaceView": {
      "type": "object",
      "required": ["azimuth", "elevation", "unit"],
      "additionalProperties": false,
      "properties": {
        "azimuth": {
          "type": "number",
          "description": "方位角(度)．z軸のまわりに，x軸からy軸の向きに測る．"
        },
        "elevation": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "仰角(度)．xy平面から上向きに測る．"
        },
        "unit": { "$ref": "#/$defs/length", "description": "3方向共通の，1単位の実寸．" }
      }
    },
    "view": {
      "description": "図の見え方．平面の図は`x`，`y`，`unit`を持ち，空間の図は`azimuth`，`elevation`，`unit`を持つ．どちらの形になるかで，平面の図か空間の図かが決まり，使えるオブジェクトの種類も変わる．",
      "oneOf": [{ "$ref": "#/$defs/planeView" }, { "$ref": "#/$defs/spaceView" }]
    },
    "axis": {
      "type": "object",
      "required": ["id", "type", "direction"],
      "additionalProperties": false,
      "description": "座標軸．平面の図はx軸とy軸，空間の図はx軸・y軸・z軸を使える．空間の図の軸には，`range`が必要である．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "axis" },
        "direction": { "$ref": "#/$defs/direction" },
        "arrow": { "$ref": "#/$defs/arrow" },
        "label": { "type": "string", "description": "軸の名前の式(TeX)．`\"x\"`は$x$と組まれる．" },
        "range": {
          "$ref": "#/$defs/numberPair",
          "description": "軸を引く範囲．平面の図では省くと見える範囲になる．空間の図では必要である．小さい方が先．"
        },
        "style": { "$ref": "#/$defs/style" },
        "ticks": {
          "type": "array",
          "items": { "$ref": "#/$defs/tick" },
          "description": "目盛．空間の図の軸には，まだ付けられない．"
        }
      }
    },
    "label": {
      "type": "object",
      "required": ["id", "type", "at", "tex"],
      "additionalProperties": false,
      "description": "数式を置くラベル．原点の`O`も，ラベルで書く．変換(`transform`)は位置だけを動かし，文字の向きや大きさは変えない．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "label" },
        "transform": { "$ref": "#/$defs/transform" },
        "at": { "$ref": "#/$defs/position" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "tex": {
          "$ref": "#/$defs/nonBlankString",
          "description": "TeXの文字列．`$…$`が数式になる．"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["id", "type", "value"],
      "additionalProperties": false,
      "description": "式から名前で参照する数．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "parameter" },
        "value": { "type": "number" }
      }
    },
    "graph": {
      "type": "object",
      "required": ["id", "type", "var", "expr", "domain"],
      "additionalProperties": false,
      "description": "関数のグラフ(y = f(x))．平面の図でだけ使える．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "graph" },
        "var": { "$ref": "#/$defs/identifier" },
        "expr": { "$ref": "#/$defs/nonBlankString" },
        "domain": {
          "$ref": "#/$defs/boundPair",
          "description": "定義域．数どうしなら，小さい方が先でなければならない．"
        },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "curve": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "description": "媒介変数表示の曲線．式(`var`，`expr`，`domain`)か，ベジエ曲線の制御点(`bezier`)か，スプライン曲線が通る点(`spline`)の，どれか1つで書く．2つ以上は書けない．",
      "oneOf": [
        {
          "required": ["var", "expr", "domain"],
          "not": { "anyOf": [{ "required": ["bezier"] }, { "required": ["spline"] }] }
        },
        {
          "required": ["bezier"],
          "not": {
            "anyOf": [
              { "required": ["var"] },
              { "required": ["expr"] },
              { "required": ["domain"] },
              { "required": ["spline"] }
            ]
          }
        },
        {
          "required": ["spline"],
          "not": {
            "anyOf": [
              { "required": ["var"] },
              { "required": ["expr"] },
              { "required": ["domain"] },
              { "required": ["bezier"] }
            ]
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "curve" },
        "var": { "$ref": "#/$defs/identifier" },
        "expr": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlankString" },
          "minItems": 2,
          "maxItems": 3,
          "description": "各座標の式．平面の図では2個，空間の図では3個でなければならない．どちらの数にするかは`view`で決まる．"
        },
        "domain": { "$ref": "#/$defs/boundPair" },
        "bezier": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/bound" },
            "minItems": 2,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 12,
          "description": "ベジエ曲線の制御点．各点は，平面の図では2個，空間の図では3個の，数か式で書く座標である．2点以上12点以下を並べる．媒介変数の範囲は，0から1である．"
        },
        "spline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/bound" },
            "minItems": 2,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 12,
          "description": "スプライン曲線が，順に通る点．各点は，平面の図では2個，空間の図では3個の，数か式で書く座標である．2点以上12点以下を並べる．媒介変数の範囲は，0から1である．Catmull-Romの方法で，与えた点をすべて通る滑らかな曲線になる．"
        },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "tangent_line": {
      "type": "object",
      "required": ["id", "type", "of", "at"],
      "additionalProperties": false,
      "description": "グラフか曲線の接線．平面の図でだけ使える．接する点での向きは，数値微分(中心差分)で求める．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "tangent_line" },
        "transform": { "$ref": "#/$defs/transform" },
        "of": {
          "$ref": "#/$defs/identifier",
          "description": "接する対象の`id`．`graph`か`curve`オブジェクトのものでなければならない．"
        },
        "at": {
          "$ref": "#/$defs/bound",
          "description": "接する点．`of`がグラフなら変数の値，曲線なら媒介変数の値．"
        },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "grid": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "description": "格子．範囲を，原点から数えた刻みの倍数の位置の線で区切る．`x_step`と`y_step`は，少なくとも一方が必要である．空間の図では，xy平面(z = 0)の上に引き，範囲(`x_range`，`y_range`)が要る(スキーマでは表せない)．ほかの平面には，変換で動かす．",
      "anyOf": [{ "required": ["x_step"] }, { "required": ["y_step"] }],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "grid" },
        "x_step": { "$ref": "#/$defs/positiveNumberOrExpression" },
        "y_step": { "$ref": "#/$defs/positiveNumberOrExpression" },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" },
        "x_range": {
          "$ref": "#/$defs/numberPair",
          "description": "線を引くxの範囲．平面の図では，なければ見える範囲．"
        },
        "y_range": {
          "$ref": "#/$defs/numberPair",
          "description": "線を引くyの範囲．平面の図では，なければ見える範囲．"
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["id", "type", "at"],
      "additionalProperties": false,
      "description": "点．座標は，あとに置いたオブジェクトの式から，`<id>_x`のような名前で参照できる．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "point" },
        "at": { "$ref": "#/$defs/position" },
        "label": { "type": "string", "description": "点の名前の式(TeX)．省くと，名前を置かない．" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "dot": { "type": "boolean", "description": "点の印(塗った丸)を描くか．既定は描かない．" },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "vector": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "additionalProperties": false,
      "description": "向きのある線分．`from`と`to`は，`point`オブジェクトの`id`でなければならない．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "vector" },
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "arrow": { "$ref": "#/$defs/arrow" },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "segment": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "additionalProperties": false,
      "description": "線分(矢じりのない，向きのない線)．`from`と`to`は，`point`オブジェクトの`id`でなければならない．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "segment" },
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "region": {
      "type": "object",
      "required": ["id", "type", "between", "domain"],
      "additionalProperties": false,
      "description": "2つのグラフ(かグラフとx軸)の間の領域．斜線で埋める．平面の図でだけ使える．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "region" },
        "transform": { "$ref": "#/$defs/transform" },
        "between": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "maxItems": 2,
          "description": "領域を挟む，`graph`オブジェクトの`id`．1つならグラフとx軸の間，2つなら2つのグラフの間になる．"
        },
        "domain": {
          "$ref": "#/$defs/boundPair",
          "description": "領域のxの範囲．グラフの定義域の中でなければならない．"
        },
        "hatch": { "type": "boolean", "description": "斜線を引くか．既定は引く．" },
        "fill": { "$ref": "#/$defs/fill" },
        "angle": {
          "type": "number",
          "description": "斜線の角度(度)．x軸から反時計回りに測る．既定は45．"
        },
        "gap": { "$ref": "#/$defs/length", "description": "斜線の間隔．既定は3mm．" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "fractal": {
      "type": "object",
      "required": ["id", "type", "base", "transforms", "depth"],
      "additionalProperties": false,
      "description": "フラクタル図形．平面の図でだけ使える．反復関数系(IFS)：基本図形(`base`)を，`transforms`で`depth`回，再帰的に写す．深さ0は`base`をそのまま描き，深さnは，深さn-1の図形全体に，それぞれの変換を施したものをすべて集めたものになる．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "fractal" },
        "base": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundPair" },
          "minItems": 2,
          "maxItems": 12,
          "description": "基本図形が通る点(x，y)の列．2点以上12点以下．"
        },
        "closed": {
          "type": "boolean",
          "description": "基本図形を閉じるか(最後の点から最初の点へも線を引く)．既定は閉じない．"
        },
        "transforms": {
          "type": "array",
          "items": { "type": "array", "items": { "$ref": "#/$defs/transformStep" }, "minItems": 1 },
          "minItems": 1,
          "maxItems": 12,
          "description": "反復関数系の変換の並び．各要素は，1つの変換を表す，手順(`transformStep`)の並びである．1つ以上12個以下．写像(`map`)は使えない(スキーマでは表せない)．"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "再帰の深さ．変換の数のこの乗が，図形の数になるので，大きすぎる組み合わせは断られる．"
        },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" },
        "all_depths": {
          "type": "boolean",
          "description": "深さ0から`depth`までの図形を，すべて重ねて描くか．既定は，深さ`depth`の図形だけを描く．"
        }
      }
    },
    "sphere": {
      "type": "object",
      "required": ["id", "type", "center", "radius"],
      "additionalProperties": false,
      "description": "球．空間の図でだけ使える．変換(`transform`)があれば，同じ形の曲面(`surface`)として描く(拡大縮小で楕円面にもなる)．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "sphere" },
        "transform": { "$ref": "#/$defs/transform" },
        "center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "style": { "$ref": "#/$defs/style" },
        "wireframe": {
          "$ref": "#/$defs/style",
          "description": "球のワイヤーフレーム(経線と緯線)．この項目があれば描き，スタイルとして使う(`{}`でもよい)．省くと描かない．"
        }
      }
    },
    "surface": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "description": "曲面．空間の図でだけ使える．式(`vars`，`expr`，`domain`)か，ベジエ曲面の制御点の網(`bezier`)のどちらかで書き，両方は書けない．`control_net`は，`bezier`があるときだけ使える．",
      "oneOf": [
        {
          "required": ["vars", "expr", "domain"],
          "not": { "anyOf": [{ "required": ["bezier"] }, { "required": ["control_net"] }] }
        },
        {
          "required": ["bezier"],
          "not": {
            "anyOf": [
              { "required": ["vars"] },
              { "required": ["expr"] },
              { "required": ["domain"] }
            ]
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "surface" },
        "vars": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 2,
          "maxItems": 2,
          "description": "2つの変数の名前．重ならないこと，`e`や`pi`と重ならないことが必要である．"
        },
        "expr": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlankString" },
          "minItems": 3,
          "maxItems": 3,
          "description": "x，y，z座標の式．"
        },
        "domain": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundPair" },
          "minItems": 2,
          "maxItems": 2,
          "description": "各変数の範囲．数どうしなら，小さい方が先でなければならない．"
        },
        "bezier": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/bound" },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 2,
            "maxItems": 12
          },
          "minItems": 2,
          "maxItems": 12,
          "description": "制御点の網．`bezier[i][j]`は，1つ目の変数の方向にi番目，2つ目の変数の方向にj番目の点で，x，y，zの3つの座標を持つ．各方向に2点以上12点以下を，行の長さを揃えて並べる．"
        },
        "mesh": {
          "type": "array",
          "items": { "type": "integer", "minimum": 4, "maximum": 200 },
          "minItems": 2,
          "maxItems": 2,
          "description": "網の細かさ(各変数の方向の分割数)．既定は48と48．"
        },
        "boundary": { "type": "boolean", "description": "定義域の縁を描くか．既定は描かない．" },
        "style": { "$ref": "#/$defs/style" },
        "wireframe": {
          "$ref": "#/$defs/style",
          "description": "曲面のワイヤーフレーム(u一定・v一定の断面)．式で書いた曲面でも，ベジエ曲面でも，同じように，曲面の上の線として描く．この項目があれば描き，スタイルとして使う(`{}`でもよい)．省くと描かない．"
        },
        "wireframe_step": {
          "type": "array",
          "items": { "$ref": "#/$defs/positiveNumberOrExpression" },
          "minItems": 2,
          "maxItems": 2,
          "description": "ワイヤーフレームの刻み(u方向，v方向)．断面は，各変数が刻みの整数倍になる所のうち，定義域の内側(両端を除く)に引く．数か式で書く．省くと，どちらも定義域の幅の4分の1．ベジエ曲面の変数の範囲は0から1．`wireframe`があるときだけ使う．各方向の断面が50本を超える刻みは断られる(スキーマでは表せない)．"
        },
        "control_net": {
          "$ref": "#/$defs/style",
          "description": "ベジエ曲面の，制御点の網(行と列を結ぶ折れ線)．`bezier`があるときだけ使える．この項目があれば描き，スタイルとして使う(`{}`でもよい)．省くと描かない．"
        },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "cut": {
      "type": "object",
      "required": ["id", "type", "surface", "normal", "offset"],
      "additionalProperties": false,
      "description": "曲面の，平面による切り口．平面は，法線と定数で`normal・p = offset`と書く．空間の図でだけ使える．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "cut" },
        "transform": { "$ref": "#/$defs/transform" },
        "surface": {
          "$ref": "#/$defs/identifier",
          "description": "切る曲面の`id`．`surface`オブジェクトのものでなければならない．"
        },
        "normal": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound" },
          "minItems": 3,
          "maxItems": 3,
          "description": "平面の法線．0でない有限のベクトルでなければならない．"
        },
        "offset": { "$ref": "#/$defs/bound" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "intersection": {
      "type": "object",
      "required": ["id", "type", "surfaces"],
      "additionalProperties": false,
      "description": "2つの曲面の交線．空間の図でだけ使える．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "intersection" },
        "transform": { "$ref": "#/$defs/transform" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "description": "交わる，違う2つの`surface`オブジェクトの`id`．`surface`オブジェクトのものでなければならない．"
        },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "tangent_plane": {
      "type": "object",
      "required": ["id", "type", "of", "at", "size"],
      "additionalProperties": false,
      "description": "曲面の接平面．空間の図でだけ使える．接する点での，2つの偏微分(中心差分)の向きに張る平行四辺形として描く．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "tangent_plane" },
        "transform": { "$ref": "#/$defs/transform" },
        "of": {
          "$ref": "#/$defs/identifier",
          "description": "接する曲面の`id`．`surface`オブジェクトのものでなければならない．"
        },
        "at": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound" },
          "minItems": 2,
          "maxItems": 2,
          "description": "接する点の，曲面の2つの変数の値．"
        },
        "size": {
          "$ref": "#/$defs/positiveNumberOrExpression",
          "description": "接平面の半径(cm)．中心から各辺への距離．"
        },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "complex": {
      "type": "object",
      "required": ["id", "type", "vertices", "faces"],
      "additionalProperties": false,
      "description": "複体(頂点と面でできた図形，正多面体など)．空間の図でだけ使える．稜(辺)は，どの2つの面にも属さない稜がないよう，`faces`から自動的に決まる(スキーマでは表せない)．`faces`は，外から見て頂点が反時計回りになるように書く：稜を隠すかどうかは，その稜に隣接する2つの面の法線の向きで決まるので，向きが逆だと隠れ方が逆になる(スキーマでは表せない)．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "complex" },
        "vertices": {
          "type": "array",
          "description": "頂点の座標．3個ずつ(x，y，z)．3個以上64個以下．",
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "minItems": 3,
          "maxItems": 64
        },
        "faces": {
          "type": "array",
          "description": "面．頂点の番号(0始まり，`vertices`の添字)を，周に沿って並べる．1個以上64個以下の面，1つの面は3個以上32個以下の頂点．",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 3,
            "maxItems": 32
          },
          "minItems": 1,
          "maxItems": 64
        },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "polyhedron": {
      "type": "object",
      "required": ["id", "type", "solid", "center", "radius"],
      "additionalProperties": false,
      "description": "正多面体．種類と，中心と，半径(中心から頂点までの距離)だけで書き，頂点と面はエンジンが決める．空間の図でだけ使える．同じ頂点と面の複体(`complex`)と同じように描き，隠す．基準の向きは種類ごとに決まっていて(立方体は，面が座標軸に垂直)，ほかの向きは変換(`transform`)の回転で作る．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "polyhedron" },
        "solid": {
          "enum": ["tetrahedron", "cube", "octahedron", "dodecahedron", "icosahedron"],
          "description": "種類．正4面体，正6面体(立方体)，正8面体，正12面体，正20面体．"
        },
        "center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "中心から頂点までの距離(外接球の半径)．"
        },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "transformStep": {
      "type": "object",
      "additionalProperties": false,
      "description": "変換の手順の1つ．操作(`translate`，`rotate`，`scale`，`reflect`，`shear`，`map`)をちょうど1つ書く．数は，数か，媒介変数と定数を使う式で書く．座標の数(平面の図では2個，空間の図では3個)が合うか，`axis`が空間の図の回転にだけあるか，`center`が回転・拡大縮小・対称移動・せん断にだけあるかは，スキーマでは表せない．",
      "oneOf": [
        { "required": ["translate"] },
        { "required": ["rotate"] },
        { "required": ["scale"] },
        { "required": ["reflect"] },
        { "required": ["shear"] },
        { "required": ["map"] }
      ],
      "dependentRequired": { "axis": ["rotate"] },
      "properties": {
        "translate": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound" },
          "minItems": 2,
          "maxItems": 3,
          "description": "平行移動の量．"
        },
        "rotate": {
          "$ref": "#/$defs/bound",
          "description": "回転の角度(度)．平面の図では反時計回り，空間の図では`axis`の向きに右ねじの向き．"
        },
        "axis": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound" },
          "minItems": 3,
          "maxItems": 3,
          "description": "回転の軸の向き．空間の図の回転に要る．0でないベクトルにする．"
        },
        "scale": {
          "description": "拡大縮小の倍率．1つの数なら全方向に同じ倍率，並びなら方向ごとの倍率．負の数で反転する．",
          "oneOf": [
            { "$ref": "#/$defs/bound" },
            { "type": "array", "items": { "$ref": "#/$defs/bound" }, "minItems": 2, "maxItems": 3 }
          ]
        },
        "reflect": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound" },
          "minItems": 2,
          "maxItems": 3,
          "description": "対称移動の鏡．平面の図では鏡にする直線の向き(`[1, 0]`でx軸，`[1, 1]`で直線y = x)，空間の図では鏡にする平面の法線(`[0, 0, 1]`でxy平面)．0でないベクトルにする．"
        },
        "shear": {
          "$ref": "#/$defs/boundPair",
          "description": "せん断の量(xがyに，yがxに，それぞれ比例して動く量)．平面の図でだけ使える．"
        },
        "map": {
          "$ref": "#/$defs/identifier",
          "description": "写像(`map`オブジェクト)の`id`．線分・ベクトル・複体・正多面体とフラクタルの`transforms`には使えない(スキーマでは表せない)．"
        },
        "center": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound" },
          "minItems": 2,
          "maxItems": 3,
          "description": "回転・拡大縮小・対称移動・せん断で動かない点．なければ原点．"
        }
      }
    },
    "transform": {
      "type": "array",
      "items": { "$ref": "#/$defs/transformStep" },
      "maxItems": 16,
      "description": "変換．手順を，書いた順に施す(最初の手順が，点に最初にかかる)．"
    },
    "polygon": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "description": "多角形．辺(閉じた折れ線)と，塗った面(`fill`)でできる．平面の図でだけ使える．正多角形は辺の数(`sides`)と中心(`center`)と半径(`radius`，中心から頂点まで)で書き，底辺が水平になる向きに置く．ほかの多角形は，頂点(`vertices`)を周に沿って並べる．どちらか一方で書く．",
      "oneOf": [
        { "required": ["sides", "center", "radius"], "not": { "required": ["vertices"] } },
        {
          "required": ["vertices"],
          "not": {
            "anyOf": [
              { "required": ["sides"] },
              { "required": ["center"] },
              { "required": ["radius"] }
            ]
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "polygon" },
        "sides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 64,
          "description": "正多角形の辺の数．"
        },
        "center": { "$ref": "#/$defs/boundPair", "description": "正多角形の中心．" },
        "radius": {
          "$ref": "#/$defs/positiveNumberOrExpression",
          "description": "正多角形の，中心から頂点までの距離．"
        },
        "vertices": {
          "type": "array",
          "items": { "$ref": "#/$defs/position" },
          "minItems": 3,
          "maxItems": 64,
          "description": "頂点．座標か，点の式(`\"A\"`など)で，周に沿って並べる．"
        },
        "fill": {
          "$ref": "#/$defs/fill",
          "description": "面を塗る色と不透明度．なければ塗らない．"
        },
        "style": { "$ref": "#/$defs/style" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "function": {
      "type": "object",
      "required": ["id", "type", "vars", "expr"],
      "additionalProperties": false,
      "description": "式から呼べる関数．描かない．`id`が関数の名前になり，どのオブジェクトの式からも`f(x)`の形で呼べる．本体は，媒介変数と，先に置いた関数を使える(合成`f(g(x))`もできる)．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "function" },
        "vars": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "maxItems": 3,
          "description": "引数の名前．"
        },
        "expr": { "$ref": "#/$defs/nonBlankString", "description": "本体の式．" }
      }
    },
    "map": {
      "type": "object",
      "required": ["id", "type", "vars", "expr"],
      "additionalProperties": false,
      "description": "写像．点の座標を，同じ数の座標に写す．描かない．変換の手順`{\"map\": \"<id>\"}`で使う．変数と式の数は，平面の図では2個，空間の図では3個にする(スキーマでは表せない)．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "map" },
        "vars": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 2,
          "maxItems": 3,
          "description": "座標の変数の名前．"
        },
        "expr": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlankString" },
          "minItems": 2,
          "maxItems": 3,
          "description": "写した先の座標の式．"
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["id", "type", "of", "transform"],
      "additionalProperties": false,
      "description": "別のオブジェクトを変換した像．元のオブジェクトはそのまま残る．元にできるのは，先に置いた，座標軸・媒介変数・関数・写像を除くオブジェクト(像も含む)である(スキーマでは表せない)．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "image" },
        "of": { "$ref": "#/$defs/identifier", "description": "元のオブジェクトの`id`．" },
        "transform": { "$ref": "#/$defs/transform" },
        "label": { "type": "string", "description": "点の像の名前の式(TeX)．点の像にだけ書ける．" },
        "style": {
          "$ref": "#/$defs/style",
          "description": "書けば元のスタイルの代わりに使い，書かなければ元のスタイルを使う．"
        }
      }
    },
    "taylor": {
      "type": "object",
      "required": ["id", "type", "of", "at", "order"],
      "additionalProperties": false,
      "description": "グラフのテイラー展開を，`order`次で打ち切った多項式のグラフ．平面の図でだけ使える．展開するグラフの式は，特殊関数を含まず，中心で微分できなければならない(スキーマでは表せない)．",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "taylor" },
        "transform": { "$ref": "#/$defs/transform" },
        "of": {
          "$ref": "#/$defs/identifier",
          "description": "展開するグラフ(`graph`)の`id`．変換したグラフは使えない．"
        },
        "at": { "$ref": "#/$defs/bound", "description": "展開の中心．" },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "打ち切る次数．"
        },
        "domain": {
          "$ref": "#/$defs/boundPair",
          "description": "描く範囲．なければ，グラフの定義域．"
        },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "object": {
      "description": "図を作るオブジェクト．`type`で種類を選ぶ．`graph`，`region`，`tangent_line`，`fractal`，`polygon`，`taylor`は平面の図でだけ，`sphere`，`surface`，`cut`，`intersection`，`tangent_plane`，`complex`，`polyhedron`は空間の図でだけ使える．",
      "oneOf": [
        { "$ref": "#/$defs/axis" },
        { "$ref": "#/$defs/label" },
        { "$ref": "#/$defs/parameter" },
        { "$ref": "#/$defs/graph" },
        { "$ref": "#/$defs/curve" },
        { "$ref": "#/$defs/tangent_line" },
        { "$ref": "#/$defs/grid" },
        { "$ref": "#/$defs/point" },
        { "$ref": "#/$defs/vector" },
        { "$ref": "#/$defs/segment" },
        { "$ref": "#/$defs/region" },
        { "$ref": "#/$defs/fractal" },
        { "$ref": "#/$defs/sphere" },
        { "$ref": "#/$defs/surface" },
        { "$ref": "#/$defs/cut" },
        { "$ref": "#/$defs/intersection" },
        { "$ref": "#/$defs/tangent_plane" },
        { "$ref": "#/$defs/complex" },
        { "$ref": "#/$defs/polyhedron" },
        { "$ref": "#/$defs/polygon" },
        { "$ref": "#/$defs/function" },
        { "$ref": "#/$defs/map" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/taylor" }
      ]
    }
  }
}
